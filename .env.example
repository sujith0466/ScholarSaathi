# ============================================================
# ScholarSaathi — Environment Configuration Template (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
# ============================================================

# MongoDB Database Configuration
MONGODB_URI=
MONGODB_DB_NAME=scholarsaathi

# OpenRouter LLM API Configuration (Server-Side Only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Application Public URL
NEXT_PUBLIC_APP_URL=
